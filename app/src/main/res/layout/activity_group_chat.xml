<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/groupChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <!-- Top Chat App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:paddingStart="12dp"
        android:paddingTop="36dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnGroupBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white"
            android:contentDescription="@string/title_messages" />

        <FrameLayout
            android:id="@+id/groupAvatarContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_avatar_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnGroupBack"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivGroupAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_group"
                app:tint="@color/cyan_accent"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnGroupMenu"
            app:layout_constraintStart_toEndOf="@id/groupAvatarContainer"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                tools:text="Nexa Dev Team" />

            <TextView
                android:id="@+id/tvGroupMembersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                tools:text="5 members" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnGroupMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white"
            android:contentDescription="@string/title_group_info" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/groupBottomComposer"
        app:layout_constraintTop_toBottomOf="@id/groupAppBar"
        app:stackFromEnd="true" />

    <!-- Recording Indicator -->
    <LinearLayout
        android:id="@+id/layoutGroupRecordingOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_glass_card_elevated"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/groupBottomComposer">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/error_red"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvGroupRecordingTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="00:00"
            android:textColor="@color/error_red"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvGroupCancelRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbGroupUploadProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:progressTint="@color/cyan_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/groupBottomComposer" />

    <!-- Bottom Composer -->
    <LinearLayout
        android:id="@+id/groupBottomComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnGroupAttachFile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_attach"
            app:tint="@color/cyan_accent"
            android:contentDescription="@string/hint_type_message" />

        <ImageView
            android:id="@+id/btnGroupAttachCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/cyan_accent"
            android:contentDescription="@string/hint_type_message" />

        <EditText
            android:id="@+id/etGroupMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input"
            android:hint="@string/hint_type_message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/btnGroupSendContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_primary_gradient">

            <ImageView
                android:id="@+id/ivGroupSendIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@color/bg_dark_navy"
                android:contentDescription="@string/hint_type_message" />

            <ImageView
                android:id="@+id/ivGroupMicIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/bg_dark_navy"
                android:visibility="gone"
                android:contentDescription="@string/hint_type_message" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
