<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <!-- Top Call Info -->
    <LinearLayout
        android:id="@+id/callHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="56dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCallTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="NexaChat Audio Call"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Avatar Container -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/circle_avatar_placeholder">

            <ImageView
                android:id="@+id/ivCallAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:tint="@color/cyan_accent"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallParticipantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            tools:text="Sarah Connor" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cyan_accent"
            android:textSize="15sp"
            tools:text="Calling..." />

    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/callControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Secondary Controls Row (Mute, Speaker, Video) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="32dp">

            <!-- Mute Button -->
            <FrameLayout
                android:id="@+id/btnCallMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:id="@+id/ivCallMuteIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/text_white"
                    android:contentDescription="Mute microphone" />
            </FrameLayout>

            <!-- Video Toggle Button -->
            <FrameLayout
                android:id="@+id/btnCallVideo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:id="@+id/ivCallVideoIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_videocam"
                    app:tint="@color/text_white"
                    android:contentDescription="Toggle Video" />
            </FrameLayout>

            <!-- Speaker Button -->
            <FrameLayout
                android:id="@+id/btnCallSpeaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:id="@+id/ivCallSpeakerIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/text_white"
                    android:contentDescription="Toggle Speaker" />
            </FrameLayout>

        </LinearLayout>

        <!-- Primary Action (End Call / Reject) -->
        <FrameLayout
            android:id="@+id/btnCallEnd"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/btn_call_end">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_call_end"
                app:tint="@color/text_white"
                android:contentDescription="End Call" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
