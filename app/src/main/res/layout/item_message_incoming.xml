<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="3dp"
    android:paddingEnd="48dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/bubbleIncoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_incoming"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Sender Name (Shown in Group Chat) -->
        <TextView
            android:id="@+id/tvIncomingSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Elena Rostova" />

        <!-- Image Message Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardIncomingImage"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivIncomingImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Attached Image" />
        </androidx.cardview.widget.CardView>

        <!-- Voice Message Player -->
        <LinearLayout
            android:id="@+id/layoutIncomingAudio"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_glass_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnPlayIncomingAudio"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_play"
                app:tint="@color/cyan_accent"
                android:contentDescription="Play Audio" />

            <TextView
                android:id="@+id/tvIncomingAudioDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Voice Note"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- File Attachment View -->
        <LinearLayout
            android:id="@+id/layoutIncomingFile"
            android:layout_width="190dp"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_glass_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file"
                app:tint="@color/cyan_accent"
                android:contentDescription="File Attachment" />

            <TextView
                android:id="@+id/tvIncomingFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="document.pdf"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Text Message -->
        <TextView
            android:id="@+id/tvIncomingMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            tools:text="Hey, let's review the mockups later." />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvIncomingTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="10:45 AM" />

    </LinearLayout>

</LinearLayout>
