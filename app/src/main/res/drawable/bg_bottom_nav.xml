<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top glowing sky-blue accent line -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
            <solid android:color="#00E5FF" />
        </shape>
    </item>
    <!-- Glassmorphic translucent body -->
    <item android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F2081120"
                android:endColor="#D90F1E36" />
            <stroke
                android:width="1dp"
                android:color="#4038BDF8" />
        </shape>
    </item>
</layer-list>
