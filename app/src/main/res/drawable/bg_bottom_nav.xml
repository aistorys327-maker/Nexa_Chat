<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top glowing glass accent line -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
            <solid android:color="#8000E5FF" />
        </shape>
    </item>
    <!-- Liquid translucent glassmorphic body -->
    <item android:top="1.2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#E6100D26"
                android:endColor="#D9161238" />
            <stroke
                android:width="1dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>
</layer-list>
